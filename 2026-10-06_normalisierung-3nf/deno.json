{
  "nodeModulesDir": "none",
  "tasks": {
    "demo": "deno run --allow-read --allow-write demo.ts",
    "test": "deno test",
    "prisma:validate": "deno run -A npm:prisma@7 validate --schema prisma/schema.prisma",
    "prisma:format": "deno run -A npm:prisma@7 format --schema prisma/schema.prisma"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  }
}
